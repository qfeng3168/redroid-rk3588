# 钉死版本清单 —— 升级只改这里，并走 CI 全量重验
# google/android-cuttlefish 源码 ref（host 包构建基线）
ANDROID_CUTTLEFISH_REF=main
# 官方 guest 镜像 build（ci.android.com / aosp-android-latest-release）
CF_IMAGE_BUILD_ID=16644040
CF_IMAGE_TARGET=aosp_cf_arm64_only_phone-userdebug
CF_IMAGE_BRANCH=aosp-android-latest-release
# bazelisk 官方 .deb 版本（上游 debian/control 的 Build-Depends，Ubuntu arm64 源里没有，
# CI 里从 bazelbuild/bazelisk releases 装官方 arm64 deb 并校验 sha256）
BAZELISK_VERSION=v1.30.0
